{
  "name": "beto",
  "version": "0.8.0",
  "description": "Inbox for stuck AI coding agents. Surfaces sessions that need your input — Claude Code, Codex, OpenCode, and any harness with a plugin manifest.",
  "keywords": [
    "ai",
    "agents",
    "claude-code",
    "codex",
    "opencode",
    "tui",
    "menubar",
    "monitor",
    "cli"
  ],
  "homepage": "https://github.com/ckpxgfnksd-max/beto#readme",
  "bugs": {
    "url": "https://github.com/ckpxgfnksd-max/beto/issues"
  },
  "type": "module",
  "bin": {
    "beto": "./dist/cli.js"
  },
  "files": [
    "dist",
    "manifests",
    "bin",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun src/cli.tsx",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "bun scripts/seed-mock-jobs.ts",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^25.7.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckpxgfnksd-max/beto.git"
  }
}
