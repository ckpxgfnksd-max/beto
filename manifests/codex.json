{
  "$schema": "https://github.com/ckpxgfnksd-max/beto/blob/main/docs/manifest-spec.md",
  "id": "codex",
  "displayName": "Codex",
  "sigil": "X",
  "color": "green",
  "binary": "codex",
  "pollMs": 2000,
  "readBudgetMs": 1500,
  "adapter": {
    "kind": "jsonl-index",
    "config": {
      "filePath": "~/.codex/session_index.jsonl",
      "fieldMap": {
        "sessionId": "id",
        "name": "thread_name",
        "lastTransitionAt": "updated_at"
      }
    }
  }
}
