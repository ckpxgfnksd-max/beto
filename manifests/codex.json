{
  "$schema": "https://github.com/ckpxgfnksd-max/beto/blob/main/docs/manifest-spec.md",
  "id": "codex",
  "displayName": "Codex",
  "sigil": "X",
  "color": "green",
  "binary": "codex",
  "pollMs": 2000,
  "readBudgetMs": 1500,
  "adapter": {
    "kind": "jsonl-tail",
    "config": {
      "fileGlob": "~/.codex/sessions/**/rollout-*.jsonl",
      "tailLines": 8,
      "fieldMap": {
        "sessionId": "payload.id",
        "lastTransitionAt": "timestamp"
      },
      "headFieldMap": {
        "sessionId": "payload.id",
        "cwd": "payload.cwd",
        "name": "payload.originator"
      },
      "exclude": {
        "field": "payload.thread_source",
        "equals": "subagent"
      },
      "stateInference": [
        {
          "name": "task complete → user's turn",
          "mapsTo": "needs-input",
          "when": {
            "equals": {
              "type": "event_msg",
              "payload.type": "task_complete"
            }
          }
        },
        {
          "name": "turn aborted → stopped",
          "mapsTo": "stopped",
          "when": {
            "equals": {
              "type": "event_msg",
              "payload.type": "turn_aborted"
            }
          }
        },
        {
          "name": "stale rollout with no terminator → idle",
          "mapsTo": "idle",
          "when": {
            "minAgeMs": 300000
          }
        }
      ]
    }
  }
}
