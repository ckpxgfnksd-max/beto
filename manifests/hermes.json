{
  "$schema": "https://github.com/ckpxgfnksd-max/beto/blob/main/manifest.schema.json",
  "id": "hermes",
  "displayName": "Hermes",
  "sigil": "H",
  "color": "blueBright",
  "binary": "hermes",
  "pollMs": 2000,
  "readBudgetMs": 1500,
  "adapter": {
    "kind": "sqlite-sessions-table",
    "config": {
      "dbPath": "~/.hermes/state.db",
      "table": "sessions",
      "fieldMap": {
        "sessionId": "id",
        "name": "title",
        "state": "status",
        "summary": "current_summary",
        "lastTransitionAt": "updated_at_ms",
        "cwd": "cwd"
      },
      "where": "deleted_at IS NULL",
      "limit": 200
    }
  }
}
